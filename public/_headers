/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; form-action 'self' mailto:;

/whitepaper/*
  X-Robots-Tag: noindex, nofollow, noarchive

/resources/*
  X-Robots-Tag: noindex, nofollow, noarchive

/mvp/*
  X-Robots-Tag: noindex, nofollow, noarchive
